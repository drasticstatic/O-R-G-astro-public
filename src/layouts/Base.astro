---
import "../styles/org.css";
import OctagonMark from "../components/OctagonMark.astro";
import { url, DAPP, LIVE, PROPOSAL, ORG_KIT, ORG_LOG, LAB } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  splash?: boolean;
}
const { title, description = "The drasticstatic ORG lab: what Christopher builds for ORG, and how it's going.", splash = true } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  { href: url(""), label: "Lab" },
  { href: url("changelog"), label: "Changelog" },
  { href: url("map"), label: "Map" },
];

// This lab lives on drasticstatic.github.io, so it loads ORG's arrival kit from ORG's own site by
// absolute URL: the same files the ORG portal and AstroLog use. The site description below is the
// lab's own; ORG's org.js covers everything shared. Choices are stored under ORG's key on this
// origin, which the O-R-G dApp preview reads too, so light and motion carry between the two.
const labSite = {
  name: "the drasticstatic ORG lab",
  what: "This lab is Christopher's changelog and portfolio of what he builds for ORG: the O-R-G dApp preview first, and whatever comes next. It's a personal lab, not ORG's official site, and your light and motion carry over to the dApp preview.",
  record: {
    intro: "Two records, kept apart on purpose.",
    changelog: {
      name: "This lab's changelog",
      text: "What changed in the lab, newest first. It keeps the history from when this site was the dApp's sidecar and tracked ORG's own sites too.",
      href: LAB + "changelog/",
      label: "Read the lab changelog",
    },
    library: {
      name: "ORG's official record",
      text: "The ORG AstroLog is the official changelog for the repositories in ORG's own GitHub organization, with a library of longer write-ups on how they're built.",
      href: ORG_LOG,
      label: "Open the ORG AstroLog",
    },
  },
  sources: [
    { url: LAB + "search.json" },
    { url: ORG_LOG + "search.json", label: "ORG AstroLog", people: false },
  ],
  items: [
    { t: "dApp preview", k: "lab", i: "cube", h: DAPP, pin: true, x: "web3 wallet octagon three lights" },
  ],
};
---
<!doctype html>
<html lang="en" data-arrival-site="lab" data-arrival-splash={splash ? undefined : "off"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={url("favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={url("apple-touch-icon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..600,0..100,0..1&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500&family=Marcellus&display=swap"
    />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <!-- ORG's arrival kit (light, motion, contrast, splash, welcome guide, "/" search, avatars). -->
    <link rel="stylesheet" href={`${ORG_KIT}/arrival.css`} />
    <link rel="stylesheet" href={`${ORG_KIT}/org.css`} />
    <script is:inline define:vars={{ labSite }}>window.ARRIVAL_SITE = labSite;</script>
    <script is:inline src={`${ORG_KIT}/org.js`}></script>
    <script is:inline src={`${ORG_KIT}/arrival.js`}></script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url("")}>
          <OctagonMark size={30} />
          <span class="display">ORG</span>
          <small>drasticstatic lab</small>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.href.replace(/\/$/, "") === here ? "page" : undefined}>{n.label}</a>
          ))}
          <a href={DAPP}>dApp preview</a>
          <a href={ORG_LOG} class="official">ORG AstroLog</a>
        </nav>
        <arrival-controls></arrival-controls>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          The drasticstatic ORG lab: Christopher's previews and experiments for ORG. It isn't ORG's official site; that's <a href={LIVE}>orgspirituality.org</a>, where members vote on every change. ORG's official changelog is the <a href={ORG_LOG}>ORG AstroLog</a>.
        </p>
        <p>
          The three lights come from <a href={PROPOSAL}>Renan Teixeira's design proposal</a>. Built by <a href="https://github.com/drasticstatic">drasticstatic</a> with <a href="https://github.com/drasticstatic/anthropas-argus-alfred-public-preview">Alfred</a>. New here? Open the <a href="#welcome" data-arrival-open="guide">welcome guide</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
