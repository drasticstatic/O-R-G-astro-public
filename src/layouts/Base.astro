---
import "../styles/org.css";
import OctagonMark from "../components/OctagonMark.astro";
import { url, DAPP, LIVE, DIRECTIONS, ORG_KIT, ORG_LOG, ORG_SITE, LAB } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  /** The nav item this page belongs to (an id from the lab's nav below); otherwise matched from the URL. */
  active?: "lab" | "changelog" | "ledger" | "map" | "roadmap" | "sustainability";
  splash?: boolean;
  /** Absolute URL of a 1200×630 JPEG for link previews; defaults to the lab's social card. */
  ogImage?: string;
  ogAlt?: string;
  ogType?: "website" | "article";
}
const {
  title,
  description = "The drasticstatic ORG lab: what Christopher builds for ORG, and how it's going.",
  active,
  splash = true,
  ogImage = LAB + "social-card.jpg",
  ogAlt = "The drasticstatic ORG lab: a lab for ORG's next ideas, with ORG's rainbow octagon art.",
  ogType = "website",
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, "https://drasticstatic.github.io").toString();

// The lab's own navbar and footer groups (kit 1.2). ORG's org.js holds ORG's; this lab loads the same
// kit by absolute URL, so it swaps in its own nav and footer between org.js and arrival.js (the
// inline script in <head>). Contact, Community and Donate are ORG's, since the lab is about ORG.
const ORG_DONATE = ORG_SITE + "donate/";
const labNav = {
  label: "drasticstatic ORG lab",
  fold: 1100,
  items: [
    { id: "lab", label: "Lab", icon: "flask", href: LAB, exact: true, priority: 1, note: "The lab's front door" },
    { id: "changelog", label: "Changelog", icon: "clock-counter-clockwise", href: LAB + "changelog", priority: 3, note: "What the lab built, newest first" },
    { id: "ledger", label: "Ledger", icon: "scroll", href: LAB + "ledger", priority: 2, note: "Every public change, in plain words" },
    { id: "map", label: "Map", icon: "map-trifold", href: LAB + "map", priority: 2, note: "Every place, with a picture of each" },
    { id: "dapp", label: "dApp preview", icon: "cube", href: DAPP, priority: 3, keep: true, note: "A web3-ready preview of ORG's site" },
    {
      id: "org",
      label: "ORG",
      icon: "polygon",
      priority: 2,
      items: [
        { id: "astrolog", label: "ORG AstroLog", icon: "door-open", href: ORG_LOG, note: "ORG's official record" },
        { id: "portal", label: "ORG's entry portal", icon: "house-simple", href: ORG_SITE, note: "ORG's front door on GitHub" },
        { id: "home", label: "orgspirituality.org", icon: "globe-hemisphere-west", href: LIVE, note: "The official site, where members decide" },
        { id: "directions", label: "Three directions", icon: "compass-tool", href: DIRECTIONS, note: "Renan T's proposal, kept as history" },
      ],
    },
    {
      id: "involved",
      label: "Get involved",
      icon: "hand-heart",
      priority: 2,
      items: [
        { id: "community", label: "Community", icon: "users-three", href: LIVE + "/community", open: "community", note: "Where ORG's members talk, on Telegram" },
        { id: "contact", label: "Reach out", icon: "envelope-simple", href: LIVE + "/about#contact", open: "contact", note: "Every way to reach ORG" },
        { id: "donate", label: "Donate", icon: "heart", href: ORG_DONATE, note: "ORG's ways to give" },
      ],
    },
    {
      id: "about",
      label: "About",
      icon: "info",
      priority: 1,
      items: [
        { id: "roadmap", label: "Roadmap", icon: "path", href: LAB + "roadmap", note: "Where the lab is headed" },
        { id: "sustainability", label: "Sustainability", icon: "plant", href: LAB + "sustainability", note: "What keeps it running" },
        { id: "source", label: "The lab's source", icon: "code", href: "https://github.com/drasticstatic/O-R-G-astro-public", note: "The public mirror on GitHub" },
        { id: "drasticstatic", label: "drasticstatic", icon: "github-logo", href: "https://github.com/drasticstatic", note: "Christopher on GitHub" },
      ],
    },
  ],
};
const labFooter = {
  label: "The drasticstatic ORG lab, all the ways around",
  groups: [
    { label: "The lab", icon: "flask", items: ["lab", "changelog", "ledger", "map", "dapp"] },
    { label: "ORG", icon: "polygon", items: ["astrolog", "portal", "home", "directions"] },
    { label: "Get involved", icon: "hand-heart", items: ["community", "contact", "donate", { id: "guide", label: "Welcome guide", icon: "signpost", href: "#welcome", open: "guide" }] },
    { label: "About this lab", icon: "wrench", items: ["roadmap", "sustainability", "source", "drasticstatic"] },
  ],
  note: "A personal lab, not ORG's official site. ORG's name and octagon mark belong to ORG.",
};

// This lab lives on drasticstatic.github.io, so it loads ORG's arrival kit from ORG's own site by
// absolute URL: the same files the ORG portal and AstroLog use. The site description below is the
// lab's own; ORG's org.js covers everything shared. Choices are stored under ORG's key on this
// origin, which the O-R-G dApp preview reads too, so light and motion carry between the two.
const labSite = {
  name: "the drasticstatic ORG lab",
  what: "This lab is Christopher's changelog and portfolio of what he builds for ORG: the O-R-G dApp preview first, and whatever comes next. It's a personal lab, not ORG's official site, and your light and motion carry over to the dApp preview.",
  record: {
    intro: "Two records, kept apart on purpose.",
    share:
      "Every lab entry has its own page and its own preview card. Paste its link into Telegram, iMessage or Discord and it arrives with its title, summary and who made it; the <strong>Copy a link</strong> button on each entry does the copying.",
    changelog: {
      name: "This lab's changelog",
      text: "What changed in the lab, newest first. It keeps the history from when this site was the dApp's sidecar and tracked ORG's own sites too.",
      href: LAB + "changelog/",
      label: "Read the lab changelog",
    },
    library: {
      name: "ORG's official record",
      text: "The ORG AstroLog is the official changelog for the repositories in ORG's own GitHub organization, with a library of longer write-ups on how they're built.",
      href: ORG_LOG,
      label: "Open the ORG AstroLog",
    },
    ledger: {
      name: "This lab's ledger",
      text: "Every public change to the lab and the dApp preview, in plain words: grouped by day and by kind, and linked to the change itself. ORG's own repositories have theirs in the ORG AstroLog.",
      href: LAB + "ledger/",
      label: "Open the lab's ledger",
    },
  },
  // What's new since the last visit: the lab's own entries and ledger, not ORG's.
  news: { sources: [LAB + "latest.json"] },
  sources: [
    { url: LAB + "search.json" },
    { url: ORG_LOG + "search.json", label: "ORG AstroLog", people: false },
  ],
  items: [
    { t: "dApp preview", k: "lab", i: "cube", h: DAPP, pin: true, x: "web3 wallet octagon three lights" },
    { t: "The lab's ledger", k: "lab", i: "scroll", h: LAB + "ledger/", pin: true, x: "commits github history code record plain words" },
    { t: "ORG's ledger", k: "ORG AstroLog", i: "scroll", h: ORG_LOG + "ledger", x: "commits github history org code" },
    { t: "The lab's map", k: "lab", i: "map-trifold", h: LAB + "map", x: "sitemap pictures thumbnails diagram" },
    { t: "The lab's roadmap", k: "lab", i: "path", h: LAB + "roadmap", x: "plans next future" },
    { t: "The lab's sustainability", k: "lab", i: "plant", h: LAB + "sustainability", x: "tokens rebuild upkeep reown allowlist" },
  ],
};
---
<!doctype html>
<html lang="en" data-arrival-site="lab" data-arrival-splash={splash ? undefined : "off"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={url("favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={url("apple-touch-icon.png")} />
    <!-- Link previews (Telegram, iMessage, Slack, Discord…): every tag absolute, a real 1200×630 JPEG. -->
    <link rel="canonical" href={pageUrl} />
    <meta property="og:site_name" content="drasticstatic ORG lab" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..600,0..100,0..1&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500&family=Marcellus&display=swap"
    />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <!-- ORG's arrival kit (light, motion, contrast, splash, welcome guide, "/" search, avatars). -->
    <link rel="stylesheet" href={`${ORG_KIT}/arrival.css`} />
    <link rel="stylesheet" href={`${ORG_KIT}/org.css`} />
    <script is:inline define:vars={{ labSite }}>window.ARRIVAL_SITE = labSite;</script>
    <script is:inline src={`${ORG_KIT}/org.js`}></script>
    <!-- The lab's own navbar and footer groups, in place of ORG's, before the kit reads them. -->
    <script is:inline define:vars={{ labNav, labFooter }}>if (window.ARRIVAL) { window.ARRIVAL.nav = labNav; window.ARRIVAL.footer = labFooter; }</script>
    <script is:inline src={`${ORG_KIT}/arrival.js`}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <!-- One row at every width: the brand, the kit's navbar (it folds into "More", then a Menu button
         below 1100px, rather than wrapping) and the kit's tools. -->
    <header class="site-header">
      <a class="brand" href={url("")} aria-label="The drasticstatic ORG lab, home">
        <OctagonMark size={28} />
        <span class="arr-brand-text"><span class="display">ORG</span><small> lab</small></span>
      </a>
      <arrival-nav current={active}></arrival-nav>
      <arrival-controls></arrival-controls>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- Every way around, in groups (drawn by the kit from the lab's footer groups above). -->
    <div class="page-foot"><arrival-footer current={active}></arrival-footer></div>

    <footer class="site-footer">
      <div class="wrap">
        <p>The drasticstatic ORG lab: Christopher's previews and experiments for ORG. It isn't ORG's official site; that's orgspirituality.org, where members vote on every change, and ORG's official changelog is the ORG AstroLog. The three lights began as Renan T's design proposal, now kept as history in ORG's AstroLog.</p>
        <p class="foot-links">
          <a href={LIVE}><i class="ph ph-globe-hemisphere-west" aria-hidden="true"></i>orgspirituality.org</a>
          <a href={ORG_LOG}><i class="ph ph-door-open" aria-hidden="true"></i>ORG AstroLog</a>
          <a href={DIRECTIONS}><i class="ph ph-compass-tool" aria-hidden="true"></i>Three directions</a>
          <a href={LIVE + "/community"} data-arrival-open="community"><i class="ph ph-users-three" aria-hidden="true"></i>Community</a>
          <a href={LIVE + "/about#contact"} data-arrival-open="contact"><i class="ph ph-envelope-simple" aria-hidden="true"></i>Reach out</a>
          <a href="#welcome" data-arrival-open="guide"><i class="ph ph-signpost" aria-hidden="true"></i>Welcome guide</a>
          <a href="https://github.com/drasticstatic"><i class="ph ph-github-logo" aria-hidden="true"></i>Built by drasticstatic</a>
          <a href="https://github.com/drasticstatic/anthropas-argus-alfred-public-preview"><i class="ph ph-robot" aria-hidden="true"></i>with Alfred</a>
        </p>
      </div>
    </footer>
  </body>
</html>
