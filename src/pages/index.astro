---
import Base from "../layouts/Base.astro";
import { CHANGELOG } from "../data/changelog";
import { url, DAPP, LIVE, PROPOSAL } from "../lib/url";

const latest = CHANGELOG.slice(0, 3);
const fmt = (d: string) =>
  new Date(`${d}T12:00:00`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---
<Base title="ORG sidecar: changelog and map">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <canvas class="marble" id="marble"></canvas>
      <div class="hero-veil"></div>
    </div>
    <div class="wrap hero-inner">
      <h1 class="ink-text">What changed, and how it fits together.</h1>
      <p class="lede">
        A running record of ORG's sites, from the first home page sketches in May to today, and a map of
        how the code, the hosting, and the previews connect.
      </p>
      <div class="cta">
        <a class="oct btn" href={url("changelog")}>Read the changelog</a>
        <a class="oct btn btn-quiet" href={url("map")}>See the map</a>
      </div>
    </div>
  </section>

  <section class="wrap latest">
    <h2>Latest</h2>
    <ol>
      {latest.map((e) => (
        <li>
          <time datetime={e.date} class="muted">{fmt(e.date)}</time>
          <h3>{e.link ? <a href={e.link}>{e.title}</a> : e.title}</h3>
          <p class="muted">{e.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap elsewhere">
    <a class="oct-card oct" href={DAPP}>
      <span class="oct-inner oct">
        <img class="emblem" src={url("art/core.webp")} alt="" width="72" height="72" />
        <span><strong>dApp preview</strong><span class="muted">The octagon, three lights, and wallet connect.</span></span>
      </span>
    </a>
    <a class="oct-card oct" href={LIVE}>
      <span class="oct-inner oct">
        <img class="emblem" src={url("art/community.webp")} alt="" width="72" height="72" />
        <span><strong>orgspirituality.org</strong><span class="muted">The official site, decided by member vote.</span></span>
      </span>
    </a>
    <a class="oct-card oct" href={PROPOSAL}>
      <span class="oct-inner oct">
        <img class="emblem" src={url("art/future.webp")} alt="" width="72" height="72" />
        <span><strong>Design directions</strong><span class="muted">Renan's three proposals for a new look.</span></span>
      </span>
    </a>
  </section>
</Base>

<script>
  import { mountMarble } from "../scripts/marble";
  const c = document.getElementById("marble");
  if (c instanceof HTMLCanvasElement) mountMarble(c);
</script>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, transparent 55%, var(--background) 94%),
      linear-gradient(to right, var(--background) 0%, color-mix(in srgb, var(--background) 80%, transparent) 35%, transparent 80%);
  }
  .hero-inner { padding-block: clamp(4rem, 12vw, 9rem) clamp(4rem, 10vw, 7rem); }
  .hero h1 { font-size: clamp(2.6rem, 6.5vw, 5.2rem); line-height: 1.02; max-width: 14ch; }
  .lede { margin-top: 1.5rem; max-width: 36rem; font-size: 1.15rem; color: color-mix(in srgb, var(--foreground) 88%, transparent); }
  .cta { margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .latest { padding-block: 3rem; }
  .latest h2 { font-size: 2.2rem; }
  .latest ol { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 2rem; max-width: 46rem; }
  .latest h3 { font-size: 1.35rem; margin-top: 0.2rem; }
  .latest h3 a { color: var(--heading); text-decoration: none; }
  .latest h3 a:hover { color: var(--accent); }
  .latest p { margin-top: 0.35rem; }
  .latest time { font-size: 0.9rem; }
  .elsewhere { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); padding-block: 2rem 4rem; }
  .elsewhere a { text-decoration: none; color: var(--foreground); }
  .elsewhere .oct-inner { display: flex; align-items: center; gap: 1rem; }
  .elsewhere img { width: 72px; height: 72px; object-fit: cover; flex-shrink: 0; }
  .elsewhere strong { display: block; font-family: var(--font-heading); font-weight: 400; font-size: 1.2rem; color: var(--heading); }
  .elsewhere .muted { display: block; font-size: 0.92rem; }
  .elsewhere a:hover strong { color: var(--accent); }
</style>
