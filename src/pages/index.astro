<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="./favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="./apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>O·R·G — Sidecar</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Manrope:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Hanken+Grotesk:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<style>
			/* Palettes from the "ORG Design Directions" proposal: dark = A · Night Sanctuary, light = B · Prism Light. */
			:root,
			:root[data-theme="dark"] {
				--bg: #100e1c;
				--fg: #eee8f6;
				--muted: #b4abc9;
				--card: #1a1730;
				--line: #2f2a48;
				--accent: #e9be72;
				--heading: #c9a4ff;
				--hero-from: #2a1f52;
				--aurora: linear-gradient(90deg, #8b6cf6, #e26db1, #4fd1c5);
				--head-font: "Fraunces", Georgia, serif;
				--body-font: "Manrope", system-ui, sans-serif;
				color-scheme: dark;
			}
			:root[data-theme="light"] {
				--bg: #f5f3fa;
				--fg: #221d33;
				--muted: #5e566e;
				--card: #ffffff;
				--line: #d9d3e6;
				--accent: #8e6420;
				--heading: #6b4fa0;
				--hero-from: #ffffff;
				--aurora: linear-gradient(90deg, #ffb3c7, #ffd9a0, #c8f2c2, #a8e3f5, #c9b8ff);
				--head-font: "Newsreader", Georgia, serif;
				--body-font: "Hanken Grotesk", system-ui, sans-serif;
				color-scheme: light;
			}
			body {
				margin: 0;
				min-height: 100vh;
				background: radial-gradient(120% 70% at 50% 0%, var(--hero-from) 0%, var(--bg) 60%);
				background-color: var(--bg);
				color: var(--fg);
				font-family: var(--body-font);
				line-height: 1.6;
			}
			main { max-width: 40rem; margin: 0 auto; padding: 5rem 1.5rem 3rem; }
			.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; }
			.badge { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); font-weight: 600; }
			button.toggle {
				font: inherit; font-size: 0.85rem; color: var(--fg); background: var(--card);
				border: 1px solid var(--line); border-radius: 999px; padding: 0.4rem 0.9rem; cursor: pointer;
			}
			button.toggle:hover { border-color: var(--accent); color: var(--accent); }
			h1 {
				font-family: var(--head-font); font-weight: 500; font-size: clamp(2.2rem, 6vw, 3rem);
				line-height: 1.1; margin: 0 0 1rem; color: var(--heading);
			}
			p, li { color: var(--fg); }
			.lede { color: var(--muted); font-size: 1.05rem; }
			.card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 1.25rem 1.4rem; margin: 1.5rem 0; }
			.card h2 { font-family: var(--head-font); font-weight: 500; font-size: 1.25rem; margin: 0 0 0.4rem; color: var(--heading); }
			.card p { margin: 0; color: var(--muted); font-size: 0.95rem; }
			a { color: var(--accent); }
			.aurora-text {
				background: var(--aurora); -webkit-background-clip: text; background-clip: text; color: transparent;
			}
			footer { margin-top: 3rem; font-size: 0.85rem; color: var(--muted); }
		</style>
	</head>
	<body>
		<main>
			<div class="topbar">
				<span class="badge">Sidecar · Public preview</span>
				<button class="toggle" id="theme-toggle" type="button" aria-label="Switch theme">☀ Light</button>
			</div>
			<h1>Octagon <span class="aurora-text">Religious-Research Group</span></h1>
			<p class="lede">
				A sidecar site for the ORG dApp: the changelog published as content, and a map of the
				project's structure. Neither is populated yet — this is the first scaffold.
			</p>

			<div class="card">
				<h2><a href="https://drasticstatic.github.io/O-R-G-dapp-public-preview/">O-R-G-dapp — public preview →</a></h2>
				<p>
					The Next.js web3 dApp rebuild of orgspirituality.org. Source:
					<a href="https://github.com/drasticstatic/O-R-G-dapp-public-preview">O-R-G-dapp-public-preview</a>.
				</p>
			</div>

			<div class="card">
				<h2>Changelog</h2>
				<p>Coming soon: what has shipped, published here as it lands.</p>
			</div>

			<div class="card">
				<h2>Structure map</h2>
				<p>Coming soon: how the modules relate, with no source code shown.</p>
			</div>

			<footer>Built with Claude Code · orgspirituality.org</footer>
		</main>
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var btn = document.getElementById("theme-toggle");
				function label(t) { btn.textContent = t === "light" ? "☾ Dark" : "☀ Light"; btn.setAttribute("aria-label", "Switch to " + (t === "light" ? "dark" : "light") + " theme"); }
				var saved = null;
				try { saved = localStorage.getItem("org-theme"); } catch (e) {}
				var current = saved === "light" ? "light" : "dark";
				root.setAttribute("data-theme", current);
				label(current);
				btn.addEventListener("click", function () {
					var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
					root.setAttribute("data-theme", next);
					try { localStorage.setItem("org-theme", next); } catch (e) {}
					label(next);
				});
			})();
		</script>
	</body>
</html>
