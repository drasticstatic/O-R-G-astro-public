---
// The same map as the ORG AstroLog's, drawn from ORG's canonical copy (see src/data/map.ts).
import Base from "../layouts/Base.astro";
import OrgMap from "../components/OrgMap.astro";
import { loadMap } from "../data/map";
import { mapCardUrl } from "../og/cards";
import { ORG_LOG } from "../lib/url";

const { map, from } = await loadMap();
---
<Base
  title="Map: drasticstatic ORG lab"
  description="How ORG's code, hosting, the lab's previews and the proposals connect."
  ogImage={mapCardUrl}
  ogAlt="A map of ORG's sites: the organization's repositories, where each one runs, and the previews and proposals around them."
>
  <header class="wrap"><div class="head">
    <h1>Map</h1>
    <p class="muted">
      How ORG's repositories, hosting, the lab's previews and the proposals connect. Solid lines carry code or
      traffic; dashed lines show where one project borrows from another. Dashed boxes are private.
    </p>
    <p class="muted source">
      This is the same map as the <a href={`${ORG_LOG}map`}>ORG AstroLog's</a>: ORG keeps its one copy, and the
      lab draws it each time it's built{from === "snapshot" ? " (this build used the lab's saved copy)" : ""}.
    </p>
  </div></header>
  <div class="wrap">
    <div class="scroller">
      <OrgMap map={map} here="lab" />
    </div>
  </div>
</Base>

<style>
  .head { padding-block: 4rem 1.5rem; max-width: 48rem; }
  .head h1 { font-size: clamp(2.6rem, 6vw, 4rem); }
  .head p { margin-top: 1rem; font-size: 1.1rem; }
  .head .source { font-size: 0.95rem; }
  .scroller { overflow-x: auto; padding: 1rem; margin-bottom: 4rem; background: var(--surface); border: 1px solid var(--border); }
</style>
